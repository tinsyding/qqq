@echo off
chcp 65001 >nul
echo ======================================================
echo 正在将项目打包为独立的 Windows EXE 程序 (含现代 UI 资源)...
echo ======================================================

REM 使用 spec 配置文件打包（单文件、无黑框、禁用 UPX 压缩以提升兼容性与降低误报）
python -m PyInstaller --noconfirm --clean "错题快速转换助手.spec"

echo.
echo ======================================================
echo 打包完成！生成的可执行文件位于 dist\错题快速转换助手.exe
echo ======================================================
pause
